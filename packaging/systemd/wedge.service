#
# systemd unit for wedge. Install to /etc/systemd/system/wedge.service, then:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin wedge
#   sudo systemctl daemon-reload && sudo systemctl enable --now wedge
# Config and keys stay owned by root and readable by the wedge group only
# (threat model T5.7, T5.8). `systemctl reload wedge` sends SIGHUP.

[Unit]
Description=wedge web and application server
Documentation=https://github.com/alinganpatra20004/wedge
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=wedge
Group=wedge
ExecStartPre=/usr/bin/wedge check-config -c /etc/wedge/wedge.toml
ExecStart=/usr/bin/wedge run -c /etc/wedge/wedge.toml
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=40s

# Only the right to bind ports below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only system, no home directories, private /tmp and /dev.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ReadOnlyPaths=/etc/wedge
# Document roots are read through ProtectSystem=strict (read-only).

# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

# No core dumps: they would contain private keys (threat model residual risk).
LimitCORE=0
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
